## Kontaktny formular
CONTACT_FORM_TO_EMAIL=test@email.com
CONTACT_FORM_FROM_EMAIL=noreply@redghost.local

## reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

## SMTP nastavenia
SMTP_ENABLED=false ## Zapnut enabled SMTP ked sa bude posielat emaily cez SMTP, inak pouzije PHP mail() funkciu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@redghost.local
SMTP_FROM_NAME=Red Ghost
SMTP_TIMEOUT=15

## Logo v emaili
MAIL_LOGO_PATH=public/assets/images/logo-text.png
MAIL_LOGO_URL=
